# --- 환경변수 / 비밀정보 ---
.env
backend/.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# --- DB / 로컬 캐시 데이터 ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak.*
*.bak
backend/data/corp_cache/*
!backend/data/corp_cache/.gitkeep
backend/data/documents/*
!backend/data/documents/.gitkeep

# --- 선택 항목 보고서 산출물 (POST /api/jobs/{id}/generate-report, 2026-08-03) ---
# 실행 시 REPORT_OUTPUT_DIR(기본 backend/report, 이 저장소의 .env는 저장소 루트 report/로
# 재정의돼 있음) 아래 날짜 폴더로 생성되는 결과물이다. 실제 회사명/주소/재무수치가 담긴
# 산출물이라 REPORT_OUTPUT_DIR 값과 무관하게 원격에 올라가지 않도록 두 경로 모두 무시한다
# (2026-08-04 dart-qa 지적 — backend/report/만 있어 루트 report/가 사각지대였음).
backend/report/
/report/

# --- Node / 프론트엔드 ---
node_modules/
dist/
.vite/

# --- 에디터/OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- 로그 ---
*.log

# --- PyInstaller 빌드 산출물 (실행파일은 소스가 아니라 빌드 결과물) ---
backend/build/
backend/dist/
backend/*.spec
backend/exe_test*/
